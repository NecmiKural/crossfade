{
  "node": {
    "id": "validate",
    "cluster": "crossfade-edge"
  },
  "static_resources": {
    "clusters": [
      {
        "name": "api--blue",
        "type": "STRICT_DNS",
        "connect_timeout": "1s",
        "per_connection_buffer_limit_bytes": 32768,
        "load_assignment": {
          "cluster_name": "api--blue",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "api-blue",
                        "port_value": 8080
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "health_checks": [
          {
            "timeout": "1s",
            "interval": "5s",
            "no_traffic_interval": "5s",
            "unhealthy_threshold": 2,
            "healthy_threshold": 1,
            "http_health_check": {
              "path": "/status",
              "host": "localhost"
            }
          }
        ],
        "typed_extension_protocol_options": {
          "envoy.extensions.upstreams.http.v3.HttpProtocolOptions": {
            "@type": "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions",
            "common_http_protocol_options": {
              "idle_timeout": "4s"
            },
            "explicit_http_config": {
              "http_protocol_options": {}
            }
          }
        }
      },
      {
        "name": "shop--v1",
        "type": "STRICT_DNS",
        "connect_timeout": "1s",
        "per_connection_buffer_limit_bytes": 32768,
        "load_assignment": {
          "cluster_name": "shop--v1",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "shop-v1",
                        "port_value": 3000
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "health_checks": [
          {
            "timeout": "1s",
            "interval": "5s",
            "no_traffic_interval": "5s",
            "unhealthy_threshold": 2,
            "healthy_threshold": 1,
            "http_health_check": {
              "path": "/healthz",
              "host": "localhost"
            }
          }
        ],
        "typed_extension_protocol_options": {
          "envoy.extensions.upstreams.http.v3.HttpProtocolOptions": {
            "@type": "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions",
            "common_http_protocol_options": {
              "idle_timeout": "4s"
            },
            "explicit_http_config": {
              "http_protocol_options": {}
            }
          }
        }
      },
      {
        "name": "shop--v2",
        "type": "STRICT_DNS",
        "connect_timeout": "1s",
        "per_connection_buffer_limit_bytes": 32768,
        "load_assignment": {
          "cluster_name": "shop--v2",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "shop-v2",
                        "port_value": 3000
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "health_checks": [
          {
            "timeout": "1s",
            "interval": "5s",
            "no_traffic_interval": "5s",
            "unhealthy_threshold": 2,
            "healthy_threshold": 1,
            "http_health_check": {
              "path": "/healthz",
              "host": "localhost"
            }
          }
        ],
        "typed_extension_protocol_options": {
          "envoy.extensions.upstreams.http.v3.HttpProtocolOptions": {
            "@type": "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions",
            "common_http_protocol_options": {
              "idle_timeout": "4s"
            },
            "explicit_http_config": {
              "http_protocol_options": {}
            }
          }
        }
      }
    ],
    "listeners": [
      {
        "name": "edge",
        "address": {
          "socket_address": {
            "address": "0.0.0.0",
            "port_value": 8080
          }
        },
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.http_connection_manager",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                  "stat_prefix": "edge",
                  "route_config": {
                    "name": "edge",
                    "virtual_hosts": [
                      {
                        "name": "localhost",
                        "domains": [
                          "localhost"
                        ],
                        "routes": [
                          {
                            "name": "api",
                            "match": {
                              "path_separated_prefix": "/api"
                            },
                            "route": {
                              "cluster": "api--blue",
                              "timeout": "60s"
                            }
                          },
                          {
                            "name": "shop",
                            "match": {
                              "prefix": "/"
                            },
                            "route": {
                              "weighted_clusters": {
                                "clusters": [
                                  {
                                    "name": "shop--v1",
                                    "weight": 50
                                  },
                                  {
                                    "name": "shop--v2",
                                    "weight": 50
                                  }
                                ]
                              },
                              "timeout": "60s"
                            }
                          }
                        ]
                      },
                      {
                        "name": "fallback",
                        "domains": [
                          "*"
                        ],
                        "routes": [
                          {
                            "name": "no-app",
                            "match": {
                              "prefix": "/"
                            },
                            "direct_response": {
                              "status": 404,
                              "body": {
                                "inline_string": "crossfade: no app for this host\n"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "http_filters": [
                    {
                      "name": "envoy.filters.http.router",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
