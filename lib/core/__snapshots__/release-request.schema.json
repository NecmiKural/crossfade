{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "app": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "candidate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 30,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthPath": {
          "default": "/healthz",
          "type": "string",
          "maxLength": 200,
          "pattern": "^\\/([A-Za-z0-9_~-][A-Za-z0-9._~-]*(\\/[A-Za-z0-9_~-][A-Za-z0-9._~-]*)*)?$"
        }
      },
      "required": [
        "name"
      ]
    },
    "plan": {
      "type": "string",
      "enum": [
        "demo",
        "standard",
        "cautious",
        "manual"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "app",
    "candidate"
  ]
}
