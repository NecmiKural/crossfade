# Optional overrides for `docker compose`. Secrets are generated by the `init` service; never put them here.

# Interface the dashboard and CI API listen on. Keep 127.0.0.1 unless a proxy in front adds authentication.
# DASHBOARD_BIND=127.0.0.1

# Interface the public edge listens on. With ENVOY_BOOTSTRAP=envoy.behind-proxy.yaml (Envoy trusts one
# X-Forwarded-For hop), set this to 127.0.0.1 so clients cannot reach Envoy without the proxy.
# EDGE_BIND=0.0.0.0
# ENVOY_BOOTSTRAP=envoy.yaml
